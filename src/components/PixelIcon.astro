---
interface Props {
  id: string;
}
const { id } = Astro.props;
const chips = ['cpu', 'v8', 'transistors', 'silicon'];
const archives = ['postgres', 'postgrest', 'ripgrep', 'opencolorio'];
const shape =
  id === 'electricity'
    ? 'M9 1H5V8H8L6 15L13 6H9Z'
    : chips.includes(id)
      ? 'M4 4H12V12H4ZM6 1V4M10 1V4M6 12V15M10 12V15M1 6H4M1 10H4M12 6H15M12 10H15'
      : archives.includes(id)
        ? 'M3 2H13V14H3ZM3 6H13M3 10H13M6 4H10M6 8H10M6 12H10'
        : 'M1 2H15V11H1ZM5 14H11M8 11V14M4 5L6 7L4 9M8 9H11';
---

<svg class="pixel-icon" viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges">
  <path d={shape} fill="none" stroke="currentColor" stroke-width="1" />
</svg>
