---
interface Props {
  id: string;
  size?: number;
}
const { id, size = 36 } = Astro.props;
const glyphs: Record<string, string> = {
  electron: '◎',
  xterm: '>_',
  ripgrep: '⌕',
  postgres: 'Pg',
  postgrest: '↔',
  deno: 'D',
  ffmpeg: '≋',
  qt: 'Qt',
  cef: '⊞',
  chromium: '◉',
  node: 'JS',
  firefox: 'Fx',
  blender: 'Bl',
  godot: 'Gd',
  gecko: 'G',
  spidermonkey: 'JS',
  nss: 'TLS',
  cycles: 'Cy',
  opencolorio: 'Co',
  jolt: 'J',
  freetype: 'Ft',
  harfbuzz: 'Hb',
  v8: 'V8',
  linux: 'OS',
  cpu: 'CPU',
  transistors: '01',
  silicon: 'Si',
  electricity: 'W',
};
---

<span class:list={['product-mark', id]} style={`--mark-size:${size}px`} aria-hidden="true">
  {id === 'vscode' ? (
    <svg viewBox="0 0 32 32">
      <path
        fill="currentColor"
        d="m23.4 1 7.1 3.4v23.2L23.4 31 10 19.4 3.3 25 0 23.4V8.6L3.3 7l6.7 5.6L23.4 1ZM23 8.2 14 16l9 7.8V8.2ZM3.5 11v10L8 16l-4.5-5Z"
      />
    </svg>
  ) : id === 'supabase' ? (
    <svg viewBox="0 0 32 32">
      <path fill="currentColor" d="M18.6 0 3 18.4h13.3L13.4 32 29 13.6H15.7L18.6 0Z" />
    </svg>
  ) : id === 'obs-studio' ? (
    <svg viewBox="0 0 32 32">
      <circle cx="16" cy="16" r="15" fill="currentColor" />
      <g fill="#f7f4ed">
        <path d="M17 4c-7 0-11 7-7 13-1-7 6-11 11-7 0-3-2-5-4-6Z" />
        <path d="M27 20c4-6 0-13-7-13 7 3 6 11 0 14 3 1 6 1 7-1Z" />
        <path d="M6 23c4 6 12 5 15-1-6 4-12-1-11-7-3 2-5 5-4 8Z" />
      </g>
    </svg>
  ) : (
    <span>{glyphs[id] ?? '▥'}</span>
  )}
</span>
