---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { foundationIllustration } from '../lib/pixel-art';
import Mark from './Mark.astro';
import Evidence from './Evidence.astro';
import {
  products,
  relationships,
  entity,
  outgoing,
  paths,
  foundationHref,
  pathBasis,
  basisLabels,
  type Foundation,
  type Product,
} from '../lib/data';
interface Props {
  foundation: Foundation;
  product?: Product;
}
const { foundation: f, product: p } = Astro.props;
const chain = p ? paths(p.id, f.id).sort((a, b) => a.length - b.length)[0] : undefined;
const uses = products.flatMap((product) => {
  const path = paths(product.id, f.id).sort((a, b) => a.length - b.length)[0];
  return path ? [{ product, path }] : [];
});
const deeper = outgoing(f.id);
const illustration = foundationIllustration(f.id);
const isPhysical = ['hardware', 'material', 'energy'].includes(f.layer);
---

<Layout title={f.name} description={f.description} product={p?.id}>
  <div class="wrap foundation-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {chain ? (
        chain.map((id, index) => (
          <>
            <span aria-hidden="true">/</span>
            {index === chain.length - 1 ? (
              <span aria-current="page">{entity(id).name}</span>
            ) : (
              <a href={index === 0 ? `/products/${id}/` : foundationHref(id, p!.id)}>
                {entity(id).name}
              </a>
            )}
          </>
        ))
      ) : (
        <>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{f.name}</span>
        </>
      )}
    </nav>
    <section class:list={['foundation-intro', { 'has-art': !!illustration }]}>
      <div class="foundation-emblem">
        <Mark id={f.id} size={64} />
      </div>
      <div>
        <p class="kicker">A closer look · {f.kind}</p>
        <h1>
          {f.name}
          <span class="accent">.</span>
        </h1>
        <p class="intro-description">{f.description}</p>
        {p && (
          <a class="text-link" href={`/products/${p.id}/#layer-${chain?.[1]}`}>
            Back to {p.name} <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      {illustration && (
        <figure class="pixel-figure">
          <Image
            src={illustration.src}
            alt={illustration.alt}
            width={480}
            widths={[300, 480, 720]}
            sizes="(max-width: 700px) 85vw, 320px"
            format="webp"
            quality={90}
          />
          <figcaption>Conceptual pixel-art illustration.</figcaption>
        </figure>
      )}
    </section>
    {f.layer !== 'software' && (
      <aside class="boundary-note" aria-label="Evidence boundary">
        <p class="kicker">
          {isPhysical ? 'General physical foundation' : 'Selected platform example'}
        </p>
        {deeper.length > 0 && <p>{f.boundary}</p>}
        <p>
          This is an explanatory trail, not a live trace of the machine running{' '}
          {p?.name ?? 'a product'}. Connections do not establish payment.
        </p>
      </aside>
    )}
    {deeper.length > 0 && (
      <section class="deeper-section">
        <div class="section-heading">
          <h2>And beneath {f.name}?</h2>
          <p>The next documented layer.</p>
        </div>
        {deeper.map((r) => (
          <article class="deeper-row">
            <Mark id={r.target} />
            <div>
              <h3>
                <a
                  href={foundationHref(r.target, p?.id)}
                  data-action="relationship_followed"
                  data-target={r.target}
                >
                  {entity(r.target).name} <span aria-hidden="true">→</span>
                </a>
              </h3>
              <p class="path-basis">
                {r.type} · {basisLabels[r.basis as keyof typeof basisLabels]}
              </p>
              <p>{r.provides}</p>
              {r.basis !== 'implementation' && <p class="relationship-note">{r.scope}</p>}
              <Evidence relation={r} />
            </div>
          </article>
        ))}
      </section>
    )}
    <section class="uses-section">
      <div class="section-heading">
        <h2>{f.layer === 'software' ? 'Where it appears here' : 'Trails that reach this layer'}</h2>
        <p>One sourced path per product. Platform and physical examples are marked.</p>
      </div>
      {uses.map(({ product, path }) => (
        <article class="documented-use">
          <div class="use-heading">
            <Mark id={product.id} />
            <h3>
              <a
                href={foundationHref(f.id, product.id)}
                data-action="relationship_followed"
                data-target={f.id}
              >
                {product.name}
              </a>
            </h3>
            <span class="use-kind">
              {path.length === 2
                ? 'Direct foundation'
                : `Through ${path
                    .slice(1, -1)
                    .map((id) => entity(id).name)
                    .join(' → ')}`}
            </span>
          </div>
          <p class="path-basis">{basisLabels[pathBasis(path)]}</p>
          <details class="trace-evidence">
            <summary>Follow the evidence · {path.length - 1} steps</summary>
            <ol class="connection-path">
              {path.map((id, index) => (
                <li>
                  <a
                    href={index === 0 ? `/products/${id}/` : foundationHref(id, product.id)}
                    data-action="relationship_followed"
                    data-target={id}
                  >
                    {entity(id).name}
                  </a>
                  {index < path.length - 1 && <span aria-hidden="true">→</span>}
                </li>
              ))}
            </ol>
            {path.slice(0, -1).map((id, index) => {
              const r = relationships.find(
                (edge) => edge.source === id && edge.target === path[index + 1],
              )!;
              return (
                <div class="use-evidence">
                  <p>
                    <strong>{entity(id).name}:</strong> {r.provides}
                  </p>
                  <p>
                    <strong>What it adds:</strong> {r.adds}
                  </p>
                  <Evidence relation={r} />
                </div>
              );
            })}
          </details>
        </article>
      ))}
      {uses.length === 1 && (
        <p class="empty-note">
          One documented product use in this edition. That is the limit of this dataset, not a claim
          that no other software uses {f.name}.
        </p>
      )}
    </section>
    {deeper.length === 0 && (
      <aside class="boundary-note endpoint" aria-label="End of reviewed evidence">
        <h2>Where this trail stops.</h2>
        <p>{f.boundary}</p>
        <a href="/request/">Suggest a sourced next layer →</a>
      </aside>
    )}
    <section class="use-yourself">
      <p class="kicker">Use it yourself</p>
      <h2>What you take on yourself.</h2>
      <p>{f.responsibilities}</p>
      <div class="link-pair">
        <a class="text-link" href={f.docs} target="_blank" rel="noopener noreferrer">
          Read the documentation <span aria-label="opens in new tab">↗</span>
        </a>
        <a href={f.url} target="_blank" rel="noopener noreferrer">
          {isPhysical ? 'Read the background' : 'Visit the project'}{' '}
          <span aria-label="opens in new tab">↗</span>
        </a>
      </div>
    </section>
    <div class="foundation-end">
      <a class="text-link" href={p ? `/products/${p.id}/` : '/'}>
        ← {p ? `Return to ${p.name}` : 'Choose an exploration'}
      </a>
      <a href="/request/">Know another use?</a>
    </div>
  </div>
</Layout>
