{
  "name": "shoulders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/validate-data.mjs && astro build",
    "build:release": "node scripts/release-check.mjs && pnpm build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/data.test.mjs",
    "check": "astro check && pnpm test && pnpm build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.4",
    "astro": "7.3.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
